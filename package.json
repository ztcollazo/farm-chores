{
  "name": "farm-chores",
  "productName": "farm-chores",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": ".webpack/main",
  "scripts": {
    "start": "npm run watch:css && electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts .",
    "watch:css": "postcss src/style/tailwind.css -o src/style/main.css"
  },
  "keywords": [],
  "author": "collazo",
  "license": "MIT",
  "config": {
    "forge": {
      "packagerConfig": {},
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "farm_chores"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ],
      "plugins": [
        [
          "@electron-forge/plugin-webpack",
          {
            "mainConfig": "./webpack.config.js",
            "renderer": {
              "config": "./webpack.renderer.config.js",
              "entryPoints": [
                {
                  "html": "./src/index.html",
                  "js": "./src/renderer.ts",
                  "name": "main_window"
                }
              ]
            }
          }
        ]
      ]
    }
  },
  "devDependencies": {
    "@electron-forge/cli": "^6.0.0-beta.54",
    "@electron-forge/maker-deb": "^6.0.0-beta.54",
    "@electron-forge/maker-rpm": "^6.0.0-beta.54",
    "@electron-forge/maker-squirrel": "^6.0.0-beta.54",
    "@electron-forge/maker-zip": "^6.0.0-beta.54",
    "@electron-forge/plugin-webpack": "^6.0.0-beta.54",
    "@marshallofsound/webpack-asset-relocator-loader": "^0.5.0",
    "@types/react": "^17.0.3",
    "@types/react-big-calendar": "^0.31.0",
    "@types/react-dom": "^17.0.2",
    "@types/tailwindcss": "^2.0.2",
    "@typescript-eslint/eslint-plugin": "^4.18.0",
    "@typescript-eslint/parser": "^4.18.0",
    "autoprefixer": "^10.2.5",
    "copy-webpack-plugin": "^6.4.1",
    "css-loader": "^5.2.4",
    "dotenv-webpack": "^7.0.2",
    "electron": "12.0.1",
    "eslint": "^7.22.0",
    "eslint-import-resolver-webpack": "^0.13.0",
    "eslint-plugin-import": "^2.22.1",
    "fork-ts-checker-webpack-plugin": "^5.2.1",
    "node-loader": "^1.0.2",
    "postcss-cli": "^8.3.1",
    "style-loader": "^1.3.0",
    "tailwindcss": "^2.1.2",
    "ts-loader": "^8.0.18",
    "typescript": "^4.2.3",
    "webpack": "^4.46.0"
  },
  "dependencies": {
    "@electron/remote": "^1.1.0",
    "@emotion/react": "^11.1.5",
    "@ericz1803/react-google-calendar": "^4.1.0",
    "@tailwindcss/forms": "^0.3.2",
    "electron-squirrel-startup": "^1.0.0",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-use": "^17.2.1",
    "tailwindcss": "^2.1.2"
  }
}
