{
  "compilerOptions": {
    "jsx": "react",
    "allowJs": true,
    "module": "commonjs",
    "target": "es2017",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "paths": {
      "*": ["./node_modules/*", "./src/lib/*"]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./typedefs"
    ]
  },
  "include": [
    "./src/**/*",
    "./typedefs/**/*"
  ]
}
